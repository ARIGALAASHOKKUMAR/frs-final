
{
  "expo": {
    "name": "APFD-FRS",
    "slug": "APFD-FRS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ashokarigala.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.ashokarigala.mobile"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "@rbayuokt/expo-face-vision",
        { "cameraPermission": "Allow APFD-FRS to check face position and blink for attendance." }
      ]
    ]
  }
}
